{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "米奇",
  "version": "1.3.0",
  "identifier": "local.codex.mickey-companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "米奇",
        "url": "index.html?v=1.3.0",
        "width": 192,
        "height": 208,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; img-src 'self' tauri: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../rules.json": "rules.json"
    },
    "category": "Entertainment",
    "shortDescription": "Floating desktop cat",
    "longDescription": "A transparent floating cat companion with playful animations, hydration reminders, and private local water tracking.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMkI0MkIwNjcxQUVBMzcKUldRMzZocG5zRUlyNFE2VWhrNFMzbmUyeFN3MHYzQ2RCV0poTm5xMGtDdmxUamZlZHM2V3ZZaWYK",
      "endpoints": [
        "https://github.com/Zimzheng/meowMickey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
